# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET. Server only. Never add NEXT_PUBLIC_ to this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Resend: resend.com > API Keys (SECRET)
RESEND_API_KEY=re_xxxxxxxx
# Must use a domain verified in Resend. onboarding@resend.dev works for testing only.
EMAIL_FROM="Act Avenue <tickets@yourdomain.com>"

# Your live site URL, no trailing slash. Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET. Any long random string. Protects /api/cron/hold-expiry.
CRON_SECRET=change-me
